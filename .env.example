# copy to .env (git-ignored); no secrets exist in v1
FINVEST_DATA_DIR=data
POSTGRES_PASSWORD=finvest   # used by docker compose (db + api + crawler); set it before the first `make up` (changing it later breaks auth on existing data/pg)
FINVEST_DATABASE_URL=postgresql+psycopg://finvest:finvest@localhost:5432/finvest   # host runs only; compose overrides it
FINVEST_SOURCE_TICKS=kbs
FINVEST_SOURCE_SYMBOLS=vci
FINVEST_SOURCE_BARS=vci
# make test-db builds its DSN from POSTGRES_PASSWORD above; optional FINVEST_TEST_DB=finvest_test_<branch> (see ops/README.md)
# FINVEST_RETENTION_DAYS=      # empty = keep everything
# FINVEST_RATE_PER_S={"kbs":2,"vci":2,"ssi":1}
# compose runs api + crawler as this user so files in data/raw and data/exports are yours, not root's (the Makefile fills them from `id` and wins over .env; plain `docker compose` reads them from .env)
# FINVEST_UID=1000
# FINVEST_GID=1000
