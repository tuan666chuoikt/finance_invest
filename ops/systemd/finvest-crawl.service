[Unit]
Description=Finvest ticks catch-up

[Service]
Type=oneshot
WorkingDirectory=__FI_ROOT__
EnvironmentFile=-%h/.config/finvest/env
ExecStartPre=/bin/sh -c 'for i in $(seq 36); do docker info >/dev/null 2>&1 && exit 0; sleep 5; done; exit 1'
ExecStart=/usr/bin/docker compose run --rm crawler catchup
